{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weapp-tailwindcss-next",
  "compatibility_date": "2025-12-07",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "next.tw.icebreaker.top"
    }
  ]
}
