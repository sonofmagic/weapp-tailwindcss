{
  "name": "benchmark-performance",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "weapp-tailwindcss 全链路性能报告与门禁",
  "scripts": {
    "report": "node ./scripts/cli.mjs",
    "guard": "node ./scripts/cli.mjs --guard",
    "baseline:update": "node ./scripts/cli.mjs --update-baseline",
    "profile": "node --cpu-prof --cpu-prof-dir=.tmp/performance-profile ./scripts/cli.mjs --suite postcss --runs 1 --warmups 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@weapp-tailwindcss/cn": "workspace:*",
    "@weapp-tailwindcss/engine": "workspace:*",
    "@weapp-tailwindcss/merge": "workspace:*",
    "@weapp-tailwindcss/postcss": "workspace:*",
    "@weapp-tailwindcss/runtime": "workspace:*",
    "esbuild": "^0.28.2",
    "postcss": "catalog:postcss85",
    "weapp-tailwindcss": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:vitest"
  }
}
